print('\n===[5-3]~[5-7]===')
score = int(input("점수를 입력 ==> "))
if score > 100 or score < 0:
    print('?', end='')
elif score >= 90 :
    print("A", end='')
elif score >= 80 :
    print("B", end='')
elif score >= 70 :
    print("C", end='')
elif score >= 60 :
    print("D", end='')
elif score >= 0 :
    print("F", end='')
print("학점입니다.")
